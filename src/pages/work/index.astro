---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import { WORK } from '../../lib/site/work';
import { CONTACT } from '../../lib/site/contact';

const title = 'Work: Local AI, AI Agents, Apps & Websites | Rubber Duck Tech Solutions';
const description = 'Case studies from Long Nguyen: a private local AI lab on RTX 4090s, a grounded voice support agent, an AI-first VR game, an AI coach app and more.';
const featured = WORK.filter(w => w.featured);
const more = WORK.filter(w => !w.featured);
const listSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Case studies',
  itemListElement: WORK.map((w, i) => ({ '@type': 'ListItem', position: i + 1, url: `${CONTACT.site}/work/${w.slug}/`, name: w.name })),
};
---
<BaseLayout title={title} description={description} schema={listSchema} crumbs={[{ name: 'Work', path: '/work/' }]}>
  <section class="page-hero" data-guide-section="hero">
    <div class="container-x relative">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <span aria-current="page">Work</span></nav>
      <p class="eyebrow-q">Can this person actually do the hard stuff?</p>
      <h1 class="display-h1 max-w-[18ch] mb-7">The deep end of AI, built in-house.</h1>
      <p class="answer">Long doesn't just plug in other people's AI. He runs and fine-tunes open models on in-house GPUs, builds agents that refuse to make things up, and ships real apps on top of them. That depth is what lets him tell a business, in plain English, what to buy, what to build and what it is overpaying for.</p>
    </div>
  </section>
  <section class="chapter chapter--tight" data-guide-section="proof">
    <div class="container-x grid grid-cols-1 md:grid-cols-2 gap-4">
      {featured.map((w, i) => (
        <a href={`/work/${w.slug}/`} class:list={['glass glass--link p-6 lg:p-8 block group', i === 0 && 'md:col-span-2']}>
          <div class="font-mono text-[11px] tracking-spec uppercase text-saffron mb-3">{w.kind}</div>
          <h2 class="text-[26px] lg:text-[30px] font-semibold tracking-tight2 text-bone mb-3 group-hover:text-saffron transition-colors">{w.name} →</h2>
          <p class="text-[15.5px] text-bone-dim leading-[1.6] max-w-[70ch]">{w.summary}</p>
          {w.numbers && <div class="stat-row mt-6">{w.numbers.map(n => <div class="stat" style="padding-left:0"><b>{n.value}</b><span>{n.label}</span></div>)}</div>}
        </a>
      ))}
    </div>
  </section>
  <section class="chapter chapter--tight">
    <div class="container-x">
      <div class="label mb-5">Also shipped</div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {more.map(w => (
          <a href={`/work/${w.slug}/`} class="glass glass--link p-6 block group">
            <div class="font-mono text-[11px] tracking-spec uppercase text-bone-mute mb-3">{w.kind}</div>
            <h2 class="text-[20px] font-semibold tracking-tight2 text-bone mb-2 group-hover:text-saffron transition-colors">{w.name} →</h2>
            <p class="text-[14.5px] text-bone-dim leading-[1.6]">{w.summary}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
  <CtaBand head="Want this kind of depth on your side?" />
</BaseLayout>

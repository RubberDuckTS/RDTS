---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT } from '../lib/site/contact';
const title = 'Contact Long Nguyen: Book a Free Call | Rubber Duck Tech Solutions';
const description = 'Book a free 15 to 45 minute call with Long Nguyen, email long@rubberducktechsolutions.com, or ask the duck on this site. Based in Kansas City, working remote across the US.';
const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Rubber Duck Tech Solutions',
  url: `${CONTACT.site}/contact/`,
  mainEntity: { '@id': `${CONTACT.site}/#business` },
};
---
<BaseLayout title={title} description={description} schema={contactSchema} crumbs={[{ name: 'Contact', path: '/contact/' }]}>
  <section class="page-hero" data-guide-section="book">
    <div class="container-x relative">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <span aria-current="page">Contact</span></nav>
      <p class="eyebrow-q">How do I reach Long?</p>
      <h1 class="display-h1 max-w-[16ch] mb-7">Three ways in. Pick whichever is easiest.</h1>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-10">
        <div class="glass p-7">
          <h2 class="text-[22px] font-semibold text-bone mb-2">Book a free call</h2>
          <p class="text-[15px] text-bone-dim mb-6">15, 30 or 45 minutes on Google Meet. Long reads your notes before you meet.</p>
          <a class="btn btn-primary" href={CONTACT.booking} data-guide-book>Pick a time →</a>
        </div>
        <div class="glass p-7">
          <h2 class="text-[22px] font-semibold text-bone mb-2">Email</h2>
          <p class="text-[15px] text-bone-dim mb-6">Write as much or as little as you like. Replies within one business day.</p>
          <a class="btn btn-outline-light" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
        </div>
        <div class="glass p-7">
          <h2 class="text-[22px] font-semibold text-bone mb-2">Ask the duck</h2>
          <p class="text-[15px] text-bone-dim mb-6">The guide in the corner answers questions now and passes your notes to Long.</p>
          <a class="btn btn-outline-light" href="/talk/" data-guide-open>Open the guide</a>
        </div>
      </div>
      {CONTACT.phone && <p class="mt-8 text-bone-dim">Prefer the phone? <a class="link-saffron" href={`tel:${CONTACT.phone.e164}`}>{CONTACT.phone.display}</a></p>}
      <p class="mt-8 text-[14px] text-bone-mute">Rubber Duck Tech Solutions · {CONTACT.city}, {CONTACT.regionName} · working remote with businesses across the US.</p>
    </div>
  </section>
</BaseLayout>

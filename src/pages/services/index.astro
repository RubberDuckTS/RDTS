---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SERVICES } from '../../lib/site/services';
import { CONTACT } from '../../lib/site/contact';

const title = 'AI Consulting, AI Agents, Software & Websites | Rubber Duck Tech Solutions';
const description = 'Six ways Long Nguyen helps businesses use AI: AI consulting and strategy, AI agents and automation, custom software and AI apps, websites and WordPress, page speed, SEO and AI search, and custom AI operating systems.';
const listSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Rubber Duck Tech Solutions services',
  itemListElement: SERVICES.map((s, i) => ({ '@type': 'ListItem', position: i + 1, url: `${CONTACT.site}/services/${s.slug}/`, name: s.name })),
};
---
<BaseLayout title={title} description={description} schema={listSchema} crumbs={[{ name: 'Services', path: '/services/' }]}>
  <section class="page-hero" data-guide-section="hero">
    <div class="container-x relative">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <span aria-current="page">Services</span></nav>
      <p class="eyebrow-q">What can Rubber Duck Tech Solutions do for my business?</p>
      <h1 class="display-h1 max-w-[18ch] mb-7">Anything that helps your business run on AI, properly.</h1>
      <p class="answer">Long Nguyen does six things, and AI runs through all of them: he tells you which AI tools are worth it, builds agents that take work off your team, builds the software and websites around them, makes sure customers can find you on Google and in AI answers, and for the full build, ties it all into one AI operating system for the business. One senior person, start to finish, as a project or a monthly retainer.</p>
    </div>
  </section>
  <section class="chapter chapter--tight" data-guide-section="services">
    <div class="container-x grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {SERVICES.map(s => (
        <a href={`/services/${s.slug}/`} class="glass glass--link p-6 lg:p-7 block group">
          <Icon name={s.icon} />
          <h2 class="text-[22px] font-semibold tracking-tight2 text-bone mb-2 group-hover:text-saffron transition-colors">{s.name}</h2>
          <p class="text-[15px] text-saffron-light mb-3">{s.question}</p>
          <p class="text-[14.5px] text-bone-dim leading-[1.6]">{s.description}</p>
        </a>
      ))}
      <div class="glass p-6 lg:p-7">
        <Icon name="spark" />
        <h2 class="text-[22px] font-semibold tracking-tight2 text-bone mb-2">Ongoing AI partner</h2>
        <p class="text-[14.5px] text-bone-dim leading-[1.6]">Any of the above on a monthly retainer: Long stays on as your senior AI person, keeps your tools current, ships improvements and answers questions as they come up.</p>
      </div>
    </div>
  </section>
  <CtaBand head="Not sure which one you need?" body="Most people aren't. Tell the duck what's going on, or book a free call and Long will point you at the right one." />
</BaseLayout>

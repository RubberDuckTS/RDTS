---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SERVICES, SERVICE_BY_SLUG, type Service } from '../../lib/site/services';
import { WORK_BY_SLUG } from '../../lib/site/work';
import { CONTACT } from '../../lib/site/contact';

export function getStaticPaths() {
  return SERVICES.map(s => ({ params: { slug: s.slug }, props: { service: s } }));
}
const { service: s } = Astro.props as { service: Service };
const SITE = CONTACT.site;
const url = `${SITE}/services/${s.slug}/`;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${url}#service`,
  name: s.name,
  serviceType: s.name,
  description: s.answer,
  url,
  provider: { '@id': `${SITE}/#business` },
  areaServed: [{ '@type': 'City', name: 'Kansas City' }, { '@type': 'Country', name: 'United States' }],
  potentialAction: { '@type': 'ReserveAction', name: 'Book a free call', target: CONTACT.booking },
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: s.faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const proof = s.proof.map(p => WORK_BY_SLUG[p]).filter(Boolean);
const related = s.related.map(r => SERVICE_BY_SLUG[r]).filter(Boolean);
---

<BaseLayout title={s.title} description={s.description} schema={[serviceSchema, faqSchema]} crumbs={[{ name: 'Services', path: '/services/' }, { name: s.name, path: `/services/${s.slug}/` }]}>
  <section class="page-hero" data-guide-section="hero">
    <div class="container-x relative">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/services/">Services</a> / <span aria-current="page">{s.name}</span></nav>
      <Icon name={s.icon} />
      <p class="eyebrow-q">{s.question}</p>
      <h1 class="display-h1 max-w-[20ch] mb-7">{s.h1}</h1>
      <p class="answer">{s.answer}</p>
      <div class="flex flex-col sm:flex-row gap-3 mt-9">
        <a class="btn btn-primary" href={CONTACT.booking} data-guide-book>Book a free call →</a>
        <button type="button" class="btn btn-outline-light" data-guide-ask={s.ask}>Ask the duck about this</button>
      </div>
    </div>
  </section>

  <section class="chapter chapter--tight" data-guide-section="services">
    <div class="container-x grid grid-cols-1 lg:grid-cols-12 gap-8">
      <div class="lg:col-span-5">
        <h2 class="display-h2 mb-6">Who this is for</h2>
        <ul class="tick-list">{s.forWho.map(f => <li>{f}</li>)}</ul>
      </div>
      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4">
        {s.deliverables.map(d => (
          <div class="glass p-6">
            <h3 class="text-[19px] font-semibold tracking-tight2 text-bone mb-2">{d.head}</h3>
            <p class="text-[15px] text-bone-dim leading-[1.6]">{d.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="chapter chapter--tight" data-guide-section="process">
    <div class="container-x">
      <h2 class="display-h2 mb-8">How it works</h2>
      <ol class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        {s.steps.map((st, i) => (
          <li class="glass p-6">
            <div class="font-mono text-[28px] text-saffron leading-none mb-3">0{i + 1}</div>
            <h3 class="text-[19px] font-semibold tracking-tight2 text-bone mb-2">{st.head}</h3>
            <p class="text-[15px] text-bone-dim leading-[1.6]">{st.body}</p>
          </li>
        ))}
      </ol>
      <p class="mt-5 text-[14px] text-bone-mute">Pricing depends on scope and is agreed on the first call, before any work starts.</p>
    </div>
  </section>

  {proof.length > 0 && (
    <section class="chapter chapter--tight" data-guide-section="proof">
      <div class="container-x">
        <h2 class="display-h2 mb-8">Proof it works</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {proof.map(w => (
            <a href={`/work/${w.slug}/`} class="glass glass--link p-6 block group">
              <div class="font-mono text-[11px] tracking-spec uppercase text-bone-mute mb-3">{w.kind}</div>
              <h3 class="text-[20px] font-semibold tracking-tight2 text-bone mb-2 group-hover:text-saffron transition-colors">{w.name} →</h3>
              <p class="text-[14.5px] text-bone-dim leading-[1.6]">{w.summary}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="chapter chapter--tight" data-guide-section="faq">
    <div class="container-x">
      <h2 class="display-h2 mb-8">Questions</h2>
      <div class="faq">
        {s.faqs.map(f => (
          <details class="glass"><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>
        ))}
      </div>
    </div>
  </section>

  <CtaBand ask={s.ask} />

  <section class="chapter chapter--tight">
    <div class="container-x">
      <div class="label mb-5">Related services</div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {related.map(r => (
          <a href={`/services/${r.slug}/`} class="glass glass--link p-6 block group">
            <h3 class="text-[19px] font-semibold tracking-tight2 text-bone group-hover:text-saffron transition-colors">{r.name} →</h3>
            <p class="text-[14.5px] text-bone-dim mt-2">{r.question}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

---
const { pathname } = Astro.url;
const isActive = (href: string) => pathname === href || pathname.startsWith(href === '/' ? '/__never__' : href);

const links = [
  { href: '/services/', label: 'Services' },
  { href: '/work/',     label: 'Work' },
  { href: '/about/',    label: 'About' },
  { href: '/learn/',    label: 'Learn' },
  { href: '/contact/',  label: 'Contact' },
];
const BOOKING = 'https://calendly.com/nguy4227/let-s-connect-project-role-or-collaboration';
---

<nav
  class="sticky top-0 z-40 pt-3 pb-1 px-3 sm:px-5"
  aria-label="Primary"
>
  <div class="mx-auto max-w-[1280px] bg-ink/95 backdrop-blur-md border border-ink-border rounded-pill flex items-center justify-between pl-5 pr-3 sm:pl-6 sm:pr-4 h-[58px] shadow-pill-dark">
    <a
      href="/"
      class="flex items-center gap-2.5 group"
    >
      {/* No aria-label: the logo alt plus the visible "RDTS" name the link, so
          the accessible name always contains the visible text (WCAG 2.5.3). */}
      <img src="/logo-rdts-duck.webp" alt="Rubber Duck Tech Solutions" width="44" height="44" class="w-11 h-11 object-contain shrink-0 self-center" />
      <span class="font-sans font-bold text-bone text-[19px] tracking-tight2 group-hover:text-saffron transition-colors">RDTS</span>
    </a>

    <div class="hidden lg:flex items-center gap-7 text-[14px] font-medium text-bone-dim">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={[
            'transition-colors',
            isActive(l.href) ? 'text-saffron' : 'hover:text-bone',
          ]}
        >
          {l.label}
        </a>
      ))}
    </div>

    <div class="flex items-center">
    <button type="button" class="sound-toggle" data-motion-toggle aria-pressed="false" aria-label="Pause the background animation" hidden>
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path class="motion-toggle__pause" d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" />
        <path class="motion-toggle__play" d="M8 5.5v13l10.5-6.5z" />
      </svg>
    </button>
    <button type="button" class="sound-toggle" data-sound-toggle aria-pressed="false" aria-label="Sound off. Turn on ambient sound" hidden>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" />
        <path class="sound-toggle__on" d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11" />
        <path class="sound-toggle__off" d="M16 9.5l5 5M21 9.5l-5 5" />
      </svg>
    </button>

    <a
      href={BOOKING}
      data-guide-book
      class="hidden sm:inline-flex items-center gap-2 bg-saffron hover:bg-saffron-light text-coal font-semibold rounded-pill px-5 py-2.5 text-[14px] transition-colors"
    >
      Book a free call →
    </a>
    </div>

    <button
      type="button"
      class="lg:hidden inline-flex items-center justify-center w-11 h-11 -mr-1 text-bone"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-trigger
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" class="w-5 h-5" aria-hidden="true">
        <line x1="3" y1="7"  x2="21" y2="7" />
        <line x1="3" y1="13" x2="21" y2="13" />
        <line x1="3" y1="19" x2="21" y2="19" />
      </svg>
    </button>
  </div>

  {/* Mobile drawer */}
  <div
    id="mobile-menu"
    class="lg:hidden hidden mt-2 mx-auto max-w-[1280px] bg-ink card-dark rounded-card overflow-hidden"
    aria-hidden="true"
  >
    <ul class="divide-y divide-ink-border">
      {links.map((l) => (
        <li>
          <a href={l.href} class="block px-5 py-4 text-bone hover:text-saffron text-[16px] font-medium">
            {l.label}
          </a>
        </li>
      ))}
      <li class="p-4">
        <a href={BOOKING} data-guide-book class="btn btn-primary w-full">Book a free call →</a>
      </li>
    </ul>
  </div>
</nav>

<script>
  const trigger = document.querySelector('[data-menu-trigger]') as HTMLButtonElement | null;
  const menu = document.getElementById('mobile-menu');
  if (trigger && menu) {
    const setOpen = (open: boolean) => {
      menu.classList.toggle('hidden', !open);
      menu.setAttribute('aria-hidden', open ? 'false' : 'true');
      trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
    };
    trigger.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));
    // Escape closes the open drawer and hands focus back to the trigger.
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || menu.classList.contains('hidden')) return;
      setOpen(false);
      trigger.focus();
    });
  }
</script>
